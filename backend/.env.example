# Backend environment (safe template)
# Copy to backend/.env and fill with your values.

# --- Firebase Admin (server-side only; never put in UI env) ---
# Option A: path to service account JSON file on your machine/server
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option B (alternative): inline JSON string for service account credentials
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Auth behavior ---
# Keep false in production. Set true only for local testing without Firebase Admin.
ALLOW_ANON_AUTH=false

# --- API/UI wiring ---
CORS_ORIGIN=http://localhost:3000

# --- AWS (backend-only) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# --- AI (Gemini only; get a key at https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=
# Or set GOOGLE_API_KEY if GEMINI_API_KEY is empty.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_READ_TIMEOUT=180
GEMINI_STEP2_JSON_OBJECT=auto
# AI_FEEDBACK_STEP2_MAX_ANALYSIS_CHARS=14000
