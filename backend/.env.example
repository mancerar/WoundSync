# Backend environment (safe template)
# Copy to backend/.env and fill with your values.

# --- Firebase Admin (server-side only; never put in UI env) ---
# Option A: path to service account JSON file on your machine/server
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option B (alternative): inline JSON string for service account credentials
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Auth behavior ---
# Keep false in production. Set true only for local testing without Firebase Admin.
ALLOW_ANON_AUTH=false

# --- API/UI wiring ---
CORS_ORIGIN=http://localhost:3000

# --- AWS (backend-only) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# --- Optional AI provider settings (backend-only) ---
QWEN_VL_API_KEY=
QWEN_VL_BASE_URL=https://openrouter.ai/api/v1
QWEN_VL_MODEL=Qwen2.5-VL-72B-Instruct
QWEN_VL_SITE_URL=http://localhost:3000
QWEN_VL_SITE_NAME=WoundSync
